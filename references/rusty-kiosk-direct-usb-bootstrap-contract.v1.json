{
  "schema": "rusty.kiosk.direct_usb_bootstrap_contract.v1",
  "host_provider_schema": "rusty.kiosk.host_operator.v3",
  "bootstrap_result_schema": "rusty.kiosk.direct_usb_bootstrap.v1",
  "provider_methods": {
    "status": "direct-status",
    "enable": "direct-enable",
    "disable": "direct-disable"
  },
  "enable": {
    "operation_id_transport": "content-provider-arg",
    "result_fields": {
      "operation_id": "string",
      "product_channel": "stable-or-labs",
      "package": "fixed-channel-package",
      "endpoint": "string-or-null",
      "bridge_generation": "long",
      "session_id": "string",
      "session_secret_base64": "sensitive-memory-only-string",
      "session_capability": "rusty.kiosk.direct_operator.v1",
      "expires_at_ms": "long",
      "enabled_by_request": "boolean"
    }
  },
  "disable": {
    "operation_id_transport": "content-provider-arg",
    "extras": {
      "expected_bridge_generation": "long",
      "session_id": "string"
    },
    "ownership": "operation-id-plus-session-id-plus-bridge-generation"
  },
  "authenticated_status_confirmation": {
    "path": "/v1/status",
    "required_fields": {
      "bridge_generation": "exact-bootstrap-long",
      "session_id": "exact-bootstrap-session-id"
    }
  },
  "status_returns_secret": false,
  "status": {
    "operation_id_transport": "none",
    "result_schema": "rusty.kiosk.direct_usb_bootstrap.v1",
    "convergence_fields": {
      "direct_enabled": "boolean",
      "direct_running": "boolean",
      "bridge_generation": "long",
      "operation_state": "pending-or-confirmed"
    },
    "disable_confirmed_when": "direct_enabled=false-and-direct_running=false"
  },
  "persistent_pairing_code_exported": false
}
