{
  "schema": "questionable.file_manager.android_global_focus_observation_fixture.v1",
  "runtime_contract": "questionable.file_manager.app_runtime_observation.v5",
  "global_focus_contract": "questionable.file_manager.android_global_focus_observation.v1",
  "source_command": ["shell", "dumpsys", "window", "windows"],
  "cases": [
    {
      "id": "exact-target-focus",
      "activities": "mResumedActivity: ActivityRecord{1 com.example.app/.Main}\ntopResumedActivity=ActivityRecord{2 com.example.app/.Main}\n",
      "window": "mCurrentFocus=Window{a1 u0 com.example.app/.Main}\nmFocusedApp=ActivityRecord{b2 u0 com.example.app/.Main t12}\n",
      "pidof": "456\n",
      "expected": {
        "current_focus_state": "Reported",
        "current_focus_record_count": 1,
        "current_focus_components": ["com.example.app/com.example.app.Main"],
        "focused_app_state": "Reported",
        "focused_app_record_count": 1,
        "focused_app_components": ["com.example.app/com.example.app.Main"],
        "process_quality": "PidofReportedProcesses"
      }
    },
    {
      "id": "focus-placeholder-takeover",
      "activities": "topResumedActivity=ActivityRecord{3 com.example.app/.Main}\n",
      "window": "mCurrentFocus=Window{a1 u0 com.oculus.vrshell/.FocusPlaceholderActivity}\nmFocusedApp=ActivityRecord{b2 u0 com.oculus.vrshell/.FocusPlaceholderActivity t24}\n",
      "pidof": "456\n",
      "expected": {
        "current_focus_state": "Reported",
        "current_focus_record_count": 1,
        "current_focus_components": ["com.oculus.vrshell/com.oculus.vrshell.FocusPlaceholderActivity"],
