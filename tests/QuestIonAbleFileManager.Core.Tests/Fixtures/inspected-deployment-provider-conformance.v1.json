{
  "schema": "questionable.file_manager.inspected_deployment_provider_conformance.v1",
  "purpose": "Public host-only synthetic corpus for consumers of the File Manager inspected-deployment provider.",
  "native_schema_ids": [
    "questionable.file_manager.inspected_deployment.v5",
    "questionable.file_manager.apk_launch_result.v1",
    "questionable.file_manager.launcher_export_proof.v2",
    "questionable.file_manager.app_runtime_observation.v5"
  ],
  "native_launch_envelope_invariant": {
    "schema": "questionable.file_manager.apk_launch_result.v1",
    "success": {
      "succeeded": true,
      "mutation": "non-null",
      "result": "non-null",
      "failure": "null"
    },
    "failure": {
      "succeeded": false,
      "mutation": "null",
      "result": "null",
      "failure": "non-null"
    }
  },
  "runtime_observation_v5": {
    "schema": "questionable.file_manager.app_runtime_observation.v5",
    "proves": [
      "android_installed_identity",
      "android_foreground",
      "android_top_resumed",
      "android_process",
      "android_global_current_focus",
      "android_global_focused_app"
    ],
    "does_not_prove": [
      "openxr_readiness",
      "app_effect",
      "wearer_visibility",
      "panel_paused_state",
      "advancing_focused_or_submitted_frames",
      "app_owned_handoff_marker"
    ],
    "process_observation_source": "pidof",
    "empty_pidof_meaning": "not-readiness-failure",
    "global_focus": {
      "source_command": "fixed serial-scoped dumpsys window windows",
      "facts": ["mCurrentFocus", "mFocusedApp"],
      "record_states": ["reported", "absent", "empty", "malformed", "unknown", "unavailable"],
      "multiple_records": "retained-in-source-order",
      "focus_placeholder_activity": "observed-system-component-not-universal-failure",
      "contradictions": "reported-without-handoff-or-readiness-verdict"
    }
  },
  "consumer_terminal_contract": {
    "owner": "consumer",
    "exactly_one_terminal_json_document": true,
    "all_outcomes_publish_atomically": true,
    "raw_streams_must_be_retained_and_digested": true,
    "failure_classes": [
      "invocation_failure",
      "parse_failure",
      "offline",
      "timeout",
      "cancelled",
      "provider_failure",
      "internal_failure"
    ],
    "note": "This corpus constrains a consumer wrapper; it does not add or replace a File Manager native result schema."
  },
  "cases": [
